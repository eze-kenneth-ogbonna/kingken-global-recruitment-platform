generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String
  role            String
  createdAt       DateTime         @default(now())
  workerProfile   WorkerProfile?
  employerProfile EmployerProfile?
}

model WorkerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String
  phone     String?
  country   String?
  skills    String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmployerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  companyName String
  website     String?
  country     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomerLead {
  id                              String         @id @default(uuid())
  fullName                        String
  phoneNumber                     String
  emailAddress                    String
  countryOfResidence              String?
  preferredDestinationCountry     String?
  serviceCategory                 String
  timeline                        String?
  passportStatusIfRelevant        String?
  urgencyLevel                    String         @default("normal")
  sourceChannel                   String
  assignedAgent                   String
  status                          String         @default("NEW")
  escalationStatus                String         @default("NONE")
  privacyAcknowledgementStatus    String         @default("PENDING")
  inquirySummary                  String?
  routingReason                   String?
  createdAt                       DateTime       @default(now())
  updatedAt                       DateTime       @updatedAt
  followUps                       LeadFollowUp[]

  @@index([assignedAgent, status])
  @@index([serviceCategory])
  @@index([createdAt])
}

model LeadFollowUp {
  id            String       @id @default(uuid())
  leadId        String
  assignedAgent String       @default("agent_3_crm_follow_up")
  scheduledDay  Int
  scheduledAt   DateTime
  channel       String       @default("email")
  messageDraft  String
  status        String       @default("PENDING")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  lead CustomerLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([assignedAgent, status, scheduledAt])
  @@index([leadId])
}

model Document {
  id        String   @id @default(uuid())
  userId    String
  uploaderEmail String?
  type      String   // CV | PASSPORT | CERTIFICATES
  filePath  String
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  action    String
  targetId  String
  version   Int      @default(1)
  metadata  String?
  ipAddress String?
  userAgent String?
  prevHash  String?
  hash      String   @unique
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
