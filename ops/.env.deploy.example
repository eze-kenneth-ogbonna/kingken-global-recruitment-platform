# Copy this file to `.env.deploy` on the server and fill in real values.

NODE_ENV=production
PORT=3001

# SQLite persistent DB path inside backend container volume
DATABASE_URL=file:/app/data/dev.db

JWT_SECRET=replace-with-a-strong-random-secret
MAIL_FROM=KingKen Global <no-reply@kingkenglobal.com.ng>
APP_BASE_URL=https://www.kingkenglobal.com.ng

# SMTP (optional for production mail)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Zoho Recruit integration
ZOHO_RECRUIT_ENABLED=false
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_RECRUIT_API_BASE_URL=https://recruit.zoho.com/recruit/v2
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_CANDIDATE_MODULE=Candidates
ZOHO_JOB_OPENINGS_MODULE=Job_Openings
ZOHO_AUTO_PUSH_APPLICATIONS=false
ZOHO_SUPER_ADMIN_EMAIL=kingkenglobal@gmail.com
ZOHO_SUPER_ADMIN_USER_ID=912010524
ZOHO_SYNC_NOTIFY_EMAIL=kingkenglobal@gmail.com
